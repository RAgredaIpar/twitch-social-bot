# ==============================================================================
# Twitch Social Bot - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values (or launch the interactive CLI
# to generate .env automatically with the guided setup wizard):
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Language & Localization (en, es, or custom file in locales/)
# ------------------------------------------------------------------------------
BOT_LANGUAGE=en
LOCALE_DIR=locales

# ------------------------------------------------------------------------------
# 1. AI Provider & Model (deepseek, claude, openai, gemini, groq, xai, custom)
# ------------------------------------------------------------------------------
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-api-key

# Base URL for the LLM endpoint (defaults to the official DeepSeek API).
LLM_BASE_URL=https://api.deepseek.com

# Model identifier (auto-discovered via GET /models during interactive CLI setup).
LLM_MODEL=deepseek-chat

# Allow 18+ (NSFW) content in imported character cards and replies (default: false).
ALLOW_NSFW=false

# Request timeout in milliseconds for upstream LLM API calls.
LLM_TIMEOUT_MS=8000

# ------------------------------------------------------------------------------
# 2. Twitch Configuration (OAuth & Helix API)
# ------------------------------------------------------------------------------
# Client ID of your registered app in Twitch Developer Console (https://dev.twitch.tv/console).
TWITCH_CLIENT_ID=your_twitch_client_id

# Twitch username (login) of the channel where you stream (broadcaster).
TWITCH_BROADCASTER_LOGIN=your_streamer_channel

# Twitch username (login) of the bot account (dedicated bot account recommended).
TWITCH_BOT_LOGIN=your_bot_account

# Initial OAuth tokens (Optional): If left blank, the bot automatically starts
# the interactive OAuth 2.0 Device Code Flow on startup.
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

# Local file path where OAuth tokens are stored and refreshed automatically.
TWITCH_TOKEN_FILE=.tokens.json

# ------------------------------------------------------------------------------
# 3. Personas & Social Store
# ------------------------------------------------------------------------------
# Directory containing declarative YAML persona templates.
PERSONA_DIR=personas

# Default YAML persona loaded on startup.
PERSONA_FILE=personas/cohost_amigos.yaml

# File path for the atomic JSON social database.
STORE_PATH=data/social.db

# ------------------------------------------------------------------------------
# 4. Rate Limiting & Room Buffer
# ------------------------------------------------------------------------------
# Minimum time in milliseconds between global bot replies.
GLOBAL_COOLDOWN_MS=3000

# Minimum time in milliseconds between replies to the same viewer.
USER_COOLDOWN_MS=8000

# Maximum number of recent ambient chat messages kept in the sliding room buffer.
ROOM_BUFFER_SIZE=25

# Maximum number of episodic memory facts stored per viewer (default: 150).
MAX_VIEWER_FACTS=150

# Maximum age in seconds before ambient room messages expire.
ROOM_BUFFER_MAX_AGE_SEC=600

# ------------------------------------------------------------------------------
# 5. Diagnostic HTTP Gateway
# ------------------------------------------------------------------------------
# Network address and port exposing health and status endpoints (/healthz, /status).
HTTP_ADDR=127.0.0.1:8080
