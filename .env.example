# ==============================================================================
# Twitch Social Bot - Configuración de Entorno
# ==============================================================================
# Copia este archivo como .env y completa los valores correspondientes:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración del Modelo de Lenguaje (DeepSeek / OpenAI-compatible)
# ------------------------------------------------------------------------------
# Clave de API requerida para interactuar con DeepSeek.
LLM_API_KEY=sk-tu-api-key-de-deepseek

# URL base del servicio de LLM (por defecto la API oficial de DeepSeek).
LLM_BASE_URL=https://api.deepseek.com

# Modelo a utilizar (deepseek-flash, deepseek-chat, deepseek-reasoner).
LLM_MODEL=deepseek-flash

# Tiempo límite de espera en milisegundos para solicitudes al LLM.
LLM_TIMEOUT_MS=8000

# ------------------------------------------------------------------------------
# 2. Configuración de Twitch (OAuth y Helix API)
# ------------------------------------------------------------------------------
# Client ID de tu aplicación registrada en Twitch Developer Console (https://dev.twitch.tv/console).
TWITCH_CLIENT_ID=tu_twitch_client_id

# Nombre de usuario (login) del canal donde transmites (broadcaster).
TWITCH_BROADCASTER_LOGIN=tu_canal_streamer

# Nombre de usuario (login) de la cuenta del bot (puede ser igual al canal o una cuenta secundaria).
TWITCH_BOT_LOGIN=tu_cuenta_bot

# Tokens iniciales (Opcional): Si están vacíos, el bot iniciará automáticamente
# el flujo interactivo OAuth Device Code Flow en consola para autorizarse.
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

# Archivo donde se guardan y refrescan automáticamente los tokens OAuth cifrados localmente.
TWITCH_TOKEN_FILE=.tokens.json

# ------------------------------------------------------------------------------
# 3. Personalidades y Almacén Social
# ------------------------------------------------------------------------------
# Directorio donde residen las plantillas YAML de personalidades.
PERSONA_DIR=personas

# Archivo de personalidad inicial a cargar al iniciar el bot.
PERSONA_FILE=personas/cohost_amigos.yaml

# Ruta del archivo de base de datos persistente (JSON atómico en disco).
STORE_PATH=data/social.db

# ------------------------------------------------------------------------------
# 4. Limitación de Tasa (Rate Limiting) y Buffer de Sala
# ------------------------------------------------------------------------------
# Tiempo mínimo en milisegundos entre respuestas globales del bot (cooldown global).
GLOBAL_COOLDOWN_MS=3000

# Tiempo mínimo en milisegundos entre respuestas a un mismo espectador (cooldown por usuario).
USER_COOLDOWN_MS=15000

# Capacidad máxima del buffer circular de mensajes recientes de la sala.
ROOM_BUFFER_SIZE=25

# Límite máximo de recuerdos episódicos (hechos) conservados por espectador (por defecto 15).
MAX_VIEWER_FACTS=15

# Antigüedad máxima en segundos de los mensajes conservados en el buffer de sala.
ROOM_BUFFER_MAX_AGE_SEC=600

# ------------------------------------------------------------------------------
# 5. Pasarela HTTP de Diagnóstico
# ------------------------------------------------------------------------------
# Dirección y puerto para exponer los endpoints de salud y estado (/healthz, /status).
HTTP_ADDR=127.0.0.1:8080
